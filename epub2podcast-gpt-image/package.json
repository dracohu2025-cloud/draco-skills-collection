{
  "name": "epub2podcast-gpt-image",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Standalone local-first EPUB to Chinese podcast video pipeline with GPT-Image visual slides and YouTube publishing assets.",
  "license": "MIT",
  "keywords": [
    "epub",
    "podcast",
    "tts",
    "slides",
    "smart-slide",
    "video",
    "mp4",
    "hermes-skill",
    "gpt-image",
    "youtube",
    "audiobook"
  ],
  "bin": {
    "epub2podcast-gpt-run": "dist/cli/run.js",
    "epub2podcast-gpt-regenerate-slide": "dist/cli/regenerate-slide.js",
    "epub2podcast-gpt-compress-video": "dist/cli/compress-video.js",
    "epub2podcast-gpt-generate-images": "dist/cli/generate-gpt-images.js"
  },
  "scripts": {
    "build": "tsc",
    "run": "node dist/cli/run.js",
    "regenerate-slide": "node dist/cli/regenerate-slide.js",
    "compress-video": "node dist/cli/compress-video.js",
    "help": "node dist/cli/run.js --help",
    "smoke-test": "bash scripts/smoke-test.sh",
    "generate-gpt-images": "node dist/cli/generate-gpt-images.js",
    "test": "node dist/__tests__/scriptServiceResponseNormalization.test.js && node dist/__tests__/imageDesigner.test.js && node dist/__tests__/gptImageSlideService.test.js"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@xmldom/xmldom": "^0.8.11",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "jszip": "^3.10.1",
    "jsonrepair": "^3.13.1",
    "puppeteer": "24.32.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.10.1",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.9.3"
  }
}
